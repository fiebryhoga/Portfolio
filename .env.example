# ==============================================
# Portfolio Environment Configuration
# ==============================================

# Backend Port
PORT=8080

# Database (PostgreSQL for Docker, or SQLite for zero-config local)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=portfolio
DB_PASSWORD=secretpassword
DB_NAME=portfolio_dev
DB_SSLMODE=disable

# JWT Secret
JWT_SECRET=super-secret-jwt-token-key-change-in-production-12345
JWT_EXPIRY_HOURS=24

# Frontend URL for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Default Admin Credentials
ADMIN_NAME=Alex Pratama
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=Admin@123456
