# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
*.env
*.env.*
!*.env.example
!**/.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# ==========================================
# Operating System & Editors
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.agents/

# ==========================================
# Database & SQLite Files
# ==========================================
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/portfolio.db

# ==========================================
# User Uploaded Media (Photos & Assets)
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# Backend Go Binaries
# ==========================================
backend/main
backend/bin/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
*.test
*.out

# ==========================================
# Frontend Node & Next.js Build Artifacts
# ==========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel/

# ==========================================
# Logs & Debugging
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
