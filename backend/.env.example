# Server Configuration
PORT=8080

# Database Configuration
# DBDriver: "postgres" or "sqlite" (default sqlite if DB_HOST is empty)
DB_DRIVER=sqlite
DB_SQLITE_PATH=portfolio.db

# If using PostgreSQL:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=portfolio
# DB_PASSWORD=secretpassword
# DB_NAME=portfolio_dev
# DB_SSLMODE=disable

# JWT Authentication
JWT_SECRET=super-secret-jwt-token-key-change-in-production-12345
JWT_EXPIRY_HOURS=24

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default Seed Admin Account
ADMIN_NAME=Alex Pratama
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=Admin@123456
